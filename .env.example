# --- LLM ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Model tiers. See docs/ARCHITECTURE.md, "The LLM gateway".
LLM_TIER_FAST_MODEL=gpt-6-luna
LLM_TIER_BALANCED_MODEL=gpt-6.1-sol
LLM_TIER_FRONTIER_MODEL=gpt-6-astra
LLM_TIER_FAST_REASONING_EFFORT=none

# --- Storage ------------------------------------------------------------
# The procedure corpus ships inside the package, so there is usually nothing
# to configure. Point this at a directory of your own to override it.
# SOP_DIR=./sops
DATABASE_URL=sqlite:///./freight.db
REDIS_URL=redis://localhost:6379/0

# --- Behaviour ----------------------------------------------------------
# How long the agent takes to react to an inbound message. The escalation
# ladder's timers are counted from the moment the message is actually sent.
AGENT_REACTION_SECONDS=60
RUN_DEADLINE_SECONDS=240
PER_LOAD_BUDGET_USD=0.50
# Force the LLM layer off. The deterministic policy path never needs the API key.
LLM_ENABLED=true

# --- Integrations -------------------------------------------------------
WEBHOOK_SECRET=change-me
INTEGRATIONS_MODE=mock         # mock | real

# --- Runtime ------------------------------------------------------------
# Run the timer worker inside the API process, on a thread. The stores are
# in-memory and therefore per-process: a worker in its own container cannot
# see the timers the API armed, so the escalation ladder would stop after the
# first rung. Turn it off once the Postgres stores exist.
TIMER_WORKER_ENABLED=true
TIMER_WORKER_POLL_SECONDS=30

# --- API ----------------------------------------------------------------
API_PORT=8000
LOG_LEVEL=INFO
